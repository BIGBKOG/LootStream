<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_up_next"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_calendar"
        android:shortcutShortLabel="@string/shortcut_up_next_short"
        android:shortcutLongLabel="@string/shortcut_up_next_long">
        <intent
            android:action="com.example.action.UP_NEXT"
            android:targetPackage="com.aistudio.lootstream.qzvkxm"
            android:targetClass="com.example.MainActivity">
            <extra android:name="EXTRA_TARGET_TAB" android:value="QUEUE" />
        </intent>
    </shortcut>

    <shortcut
